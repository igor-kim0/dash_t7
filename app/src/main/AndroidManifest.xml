<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Интернет нужен для прогноза погоды (Open-Meteo). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Только чтение состояния для иконок-индикаторов (normal, без запроса). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Подключение к ELM327 по SPP (виджет «OBD»). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Сброс режима навигатора после перезагрузки (navi/NaviBootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Для чтения VHAL на ГУ (выдаётся системным приложениям; безвредно). -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <!-- Самовключение доступа к уведомлениям (на ГУ нет экрана Settings).
         Право НЕ выдаётся при установке — только вручную:
         adb shell pm grant com.dash.headunit android.permission.WRITE_SECURE_SETTINGS
         Без объявления в манифесте pm grant отказывает. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- «Логи для Claude»: системный logcat. Выдаётся вручную:
         adb shell pm grant com.dash.headunit android.permission.READ_LOGS
         Без него в отчёт попадают только логи нашего процесса. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Видимость навигационных приложений для виджета карты (Android 11+). -->
    <queries>
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="ru.dublgis.dgismobile" />
        <package android:name="net.osmand.plus" />
        <!-- Все приложения лаунчера для виджета-приложения. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_simple"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dash.Dark">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dash.Dashboard"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Доступ к media-сессиям (BT AVRCP): включается в настройках уведомлений. -->
        <service
            android:name=".music.MediaListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Срезы шины Desay по команде с ПК (tools/hu_dump.sh). Право DUMP есть
             только у adb shell/системы — другие приложения вызвать не смогут. -->
        <receiver
            android:name=".diag.CarSnapshotReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dash.headunit.CAR_SNAPSHOT" />
            </intent-filter>
        </receiver>
        <!-- Запись приборки (QNX PPS) по команде с ПК — см. diag/ClusterRecReceiver. -->
        <receiver
            android:name=".diag.ClusterRecReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dash.headunit.CLUSTER_REC" />
            </intent-filter>
        </receiver>
        <!-- Экран мог остаться сжатым (режим навигатора) — вернуть целиком. -->
        <receiver
            android:name=".navi.NaviBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Настройка «Запускать при старте» — см. settings/AppSettings. -->
        <receiver
            android:name=".settings.AutostartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Скрытый debug-экран скана CAN (5 тапов по заголовку). -->
        <activity
            android:name=".car.CarDebugActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
