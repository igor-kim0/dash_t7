{
  "profile_name": "Chery Tiggo 7 Pro 1.6T DCT (по логу Car Scanner)",
  "profile_version": "3.0",
  "author": "Custom Diagnostic App",
  "description": "Параметры, которые реально отвечают на Tiggo 7 Pro 1.6T + DCT (VIN EDEFB32B5SE008533, ECM E21N05A502, TCM_B400_B301_02). Стандартные PID OBD-II — по маске 0100/0120/0140 ЭБУ; заводские DID (22xxxx) — по логу Car Scanner, формулы подобраны по корреляции со стандартными PID. Пометка «не сверено» в note — масштаб или назначение не подтверждены.",
  "connection_settings": {
    "protocol": "CAN_11bit_500",
    "baud_rate": 500000,
    "timeout": 2000,
    "retry_count": 3,
    "default_header": "7E0"
  },
  "diagnostic_addresses": {
    "ECM": {
      "request": "7E0",
      "response": "7E8"
    },
    "TCM": {
      "request": "7E1",
      "response": "7E9"
    },
    "DCT": {
      "request": "703",
      "response": "713"
    },
    "ABS_ESP": {
      "request": "720",
      "response": "730"
    },
    "TPMS": {
      "request": "740",
      "response": "750"
    },
    "HVAC": {
      "request": "74B",
      "response": "75B"
    }
  },
